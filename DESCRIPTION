Package: costcomorbidity
Type: Package
Title: Cost-Based Comorbidity Indices
Version: 0.1.2
Authors@R: person(
      given = "Camilla",
      family = "Nystrand",
      role = c("aut", "cre"),
      email = "camilla.nystrand1@gmail.com"
    )
Description: Calculates cost-based versions of the Charlson, Elixhauser,
    and RxRisk comorbidity indices from ICD-10 and ATC-coded data.
    Comorbidity categories are identified using established classification
    mappings and combined using cost-based weights derived and validated
    in longitudinal register data.
License: GPL-2
Encoding: UTF-8
LazyData: true
